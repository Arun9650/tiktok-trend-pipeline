# Apify
APIFY_TOKEN=your_apify_api_token
# Either point at a specific dataset from a past run...
APIFY_DATASET_ID=
# ...or let the pipeline trigger a fresh run of the scraper (slower, costs credits)
APIFY_ACTOR_ID=clockworks~tiktok-scraper
TIKTOK_HASHTAGS=stockmarket,daytrading,forex,investing,tradingtips

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram (reuse your thepawn.ai bot/chat if you want one inbox for both)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Filtering thresholds
MIN_SHARE_RATIO=0.005
MIN_PLAY_COUNT=5000
TOP_N_TRENDS=8

# Local dataset (optional, skips the Apify API if set)
LOCAL_DATASET_PATH=

# Creative Center creator discovery (finance/banking target audience)
CREATIVE_CENTER_ACTOR_ID=automation-lab~tiktok-trends-scraper
CREATIVE_CENTER_DATASET_ID=
CREATOR_TARGET_COUNTRY=US
CREATOR_TARGET_PERIOD=7
CREATOR_MAX_RESULTS=50

# Scheduler
PIPELINE_CRON_SCHEDULE=0 10,18 * * *
PIPELINE_TIMEZONE=Asia/Kolkata
